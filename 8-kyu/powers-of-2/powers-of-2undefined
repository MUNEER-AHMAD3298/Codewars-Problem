#include <vector>
#include <cstdint>
#include <cmath>
​
std::vector<uint64_t> powers_of_two(int n) {
std::vector<unsigned long>v;
 long long  int ans;
  if(n==0){
    ans=1;
    v.push_back(ans);
    }
  else{
    v.push_back(1);
  for(long long int i=1;i<=n;i++)
    {
   ans=pow(2,i);
    v.push_back(ans);
  }
    }
  return v;
}