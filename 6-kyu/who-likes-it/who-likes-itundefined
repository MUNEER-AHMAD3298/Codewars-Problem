#include <string>
#include <vector>
​
std::string likes(const std::vector<std::string> &names)
{
  std::string ans;
  if(!names.size())
    return "no one likes this";
  else if(names.size()==1){
    ans=names[0]+" likes this";
    return ans;
    }
    else if(names.size()==2){
    ans=names[0]+" and "+names[1]+" like this";
    return ans;
      }
       else if(names.size()==3){
    ans=names[0]+", "+names[1]+" and "+names[2]+" like this";
    return ans;
         }
         else{
          long long int count=names.size()-2;
           std::string a=std::to_string(count);
           ans= ans=names[0]+", "+names[1]+" and "+a+" others like this";
           return ans;
         }
  
}